# systemd unit for running Vortex OS directly on a Linux host (without Docker).
# Install: sudo cp deploy/vortex-os.service /etc/systemd/system/ && sudo systemctl enable --now vortex-os
[Unit]
Description=Vortex OS — MNX Hive cloud desktop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bee
Group=bee
WorkingDirectory=/opt/vortex
Environment=NODE_ENV=production VORTEX_HOST=127.0.0.1 VORTEX_PORT=8420 VORTEX_DATA_DIR=/var/lib/vortex
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
# Sandboxing
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/vortex
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
TasksMax=512
MemoryMax=2G

[Install]
WantedBy=multi-user.target
